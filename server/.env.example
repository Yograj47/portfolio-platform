NODE_ENV=development
PORT=3001
API_PREFIX=api
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgresql://portfolio:CHANGE_ME@localhost:5432/portfolio
JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SAME_SITE=strict
TRUST_PROXY_HOPS=0
IMAGEKIT_PRIVATE_KEY=REPLACE_WITH_IMAGEKIT_PRIVATE_KEY
# Comma-separated exact HTTPS hostnames allowed for resumeUrl; no URLs or wildcards.
CV_ALLOWED_HOSTS=ik.imagekit.io
# Used only by the seed command, never exposed by the API.
ADMIN_NAME=Yograj Rijal
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME
